# Copy to ops/.env and fill in for local dev. Never commit ops/.env.
# EU-only externals per rule R8 — see docs/SUBPROCESSORS.md.

# --- Rails ---
RAILS_ENV=development
SECRET_KEY_BASE=
# Host-side port is 5433, not 5432 (5432 is taken by another project on this host).
# Inside docker-compose the backend container reaches postgres via the service
# name on its default port; this URL is only for host-side tools (psql, etc).
DATABASE_URL=postgres://nachcare:nachcare@localhost:5433/nachcare_development
REDIS_URL=redis://localhost:6379/0

# --- Devise / JWT / TOTP (staff auth) ---
# Falls back to Rails' own secret_key_base in dev/test if unset.
DEVISE_JWT_SECRET_KEY=
# Back Rails Active Record encryption (devise-two-factor otp_secret,
# caregivers.contact, check_ins.note, assistant_turns.content). Generate via
# `bin/rails db:encryption:init`. Fixed dev-only defaults are baked into
# config/initializers/active_record_encryption.rb so a fresh checkout boots
# without these set — production MUST set real values.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Caregiver device auth ---
CAREGIVER_DEVICE_TOKEN_PEPPER=
CAREGIVER_PIN_PEPPER=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.eu

# --- LLM gateway (Section 6) ---
AI_ASSISTANT_ENABLED=true
AI_COPILOT_ENABLED=true
LLM_PRIMARY_PROVIDER=bedrock_anthropic
LLM_PRIMARY_MODEL=PLACEHOLDER_CLINICAL_set_actual_bedrock_model_id
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LLM_FALLBACK_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_KEY=

# --- Direct Anthropic API (ADR-0014) ---
# Dev-only convenience provider, NOT the R8-compliant EU path (that's
# bedrock_anthropic above, api.anthropic.com is US-hosted). Registered but
# not the active `primary` (see gemini below) — switch via
# AI_PROVIDER_OVERRIDE=anthropic if useful later. Never set in a
# production env config.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Direct Google Gemini API (ADR-0014) ---
# Also dev-only/non-EU (generativelanguage.googleapis.com). This is
# config/ai.yml's development `primary` — has a real embeddings endpoint,
# unlike the Anthropic direct API, so retrieval can use real semantic
# similarity instead of the stub's crude feature-hashing. Never set in a
# production env config.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Notifications (LogAdapter in dev; see docs/SUBPROCESSORS.md) ---
SMS_PROVIDER_URL=
SMS_API_KEY=
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Storage (prod only; local disk in dev) ---
STORAGE_S3_REGION=eu-central-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# --- Frontend (build-time, injected via Angular environment files) ---
CAREGIVER_APP_ORIGIN=http://localhost:4200
COCKPIT_APP_ORIGIN=http://localhost:4300
# Host-side port is 3001, not 3000 (3000 is taken by another project on this host).
API_ORIGIN=http://localhost:3001
