source "https://rubygems.org"

# Bundle edge Rails instead: gem "rails", github: "rails/rails", branch: "main"
gem "rails", "~> 7.2.3", ">= 7.2.3.2"
# Use postgresql as the database for Active Record
gem "pg", "~> 1.1"
# Use the Puma web server [https://github.com/puma/puma]
gem "puma", ">= 5.0"
# Build JSON APIs with ease [https://github.com/rails/jbuilder]
# gem "jbuilder"
# Use Redis adapter to run Action Cable and Sidekiq
gem "redis", ">= 4.0.1"
gem "sidekiq", "~> 7.3"
gem "sidekiq-cron", "~> 2.1"              # schedules missed_checkin_scan (23:59 daily), sla_watch, push_confirm_watch, digest

# Use Active Model has_secure_password [https://guides.rubyonrails.org/active_model_basics.html#securepassword]
# gem "bcrypt", "~> 3.1.7"

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem "tzinfo-data", platforms: %i[ windows jruby ]

# Reduces boot times through caching; required in config/boot.rb
gem "bootsnap", require: false

# Use Active Storage variants [https://guides.rubyonrails.org/active_storage_overview.html#transforming-images]
# gem "image_processing", "~> 1.2"

# Use Rack CORS for handling Cross-Origin Resource Sharing (CORS), making cross-origin Ajax possible
gem "rack-cors"
gem "csv"                                 # stdlib since Ruby <3.4, moving to a real gem in 3.4+ (M7 FR-N12 export)
gem "rack-attack", "~> 6.7"               # M7 hardening: rate limiting (ADR-0009 #6)

# --- Stack decisions per NachCareAI_Agent_Build_Instructions.md Section 2 ---
gem "pgvector", "~> 0.3"                 # low-level pg vector encoder
gem "neighbor", "~> 0.4"                 # ActiveRecord nearest-neighbor query API over pgvector
gem "pundit", "~> 2.4"                   # authorization
gem "blueprinter", "~> 1.1"              # API serialization
gem "faraday", "~> 2.9"                  # AI gateway HTTP client
gem "devise", ">= 5.0.4"                 # staff auth (>=5.0.4: CVE-2026-32700, CVE-2026-40295)
gem "devise-jwt", "~> 0.12"              # JWT sessions for cockpit users
gem "devise-two-factor", ">= 6.0"        # TOTP MFA (>=6.0: CVE-2024-8796, longer default OTP secret)
gem "prawn", "~> 2.5"                    # A5 activation code sheet PDF (ADR-0004)
gem "prawn-table", "~> 0.2"
gem "webpush", "~> 1.1"                   # Web Push (VAPID) — Section 2, M4
gem "aws-sdk-bedrockruntime", "~> 1.0"    # AI gateway primary provider (ADR-0007) — Section 6, M5

group :development, :test do
  # See https://guides.rubyonrails.org/debugging_rails_applications.html#debugging-with-the-debug-gem
  gem "debug", platforms: %i[ mri windows ], require: "debug/prelude"

  # Static analysis for security vulnerabilities [https://brakemanscanner.org/]
  gem "brakeman", require: false

  # Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
  gem "rubocop-rails-omakase", require: false

  gem "bundler-audit", require: false

  gem "rspec-rails", "~> 7.1"
  gem "factory_bot_rails", "~> 6.4"
  gem "rswag-api", "~> 2.14"
  gem "rswag-specs", "~> 2.14"
  gem "rspec-openapi", require: false
  gem "simplecov", require: false
end

group :development do
  gem "rswag-ui", "~> 2.14"
end
