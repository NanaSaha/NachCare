#!/bin/bash -e
# Runs Puma and Sidekiq in a single container process — used only by
# nachcare-backend's `dockerCommand` in render.yaml. Exists because
# Render's free instance type has no equivalent for a separate background
# worker service (see docs/adr/0016-free-tier-render-deployment.md): to
# stay at $0/month, Sidekiq's job processing (schedule.yml's cron jobs +
# async jobs) has to share the one free web service instead of running as
# its own paid `nachcare-sidekiq` worker.
#
# `preDeployCommand` also isn't supported on free-tier services (Render
# rejects the whole Blueprint if it's set), so db:prepare/db:seed run
# here instead, on every boot rather than only on deploy. Both are
# idempotent (db:seed's seed files all skip already-present data), so
# this is safe on the frequent cold-starts a free, spin-down-after-idle
# service goes through — see ADR-0016.
#
# Render doesn't guarantee nachcare-db is actually accepting connections
# by the time this container's first boot reaches this line (observed
# directly on a real first deploy: PG::ConnectionBad "Connection
# refused" against the private-network host/port from DATABASE_URL,
# not a DNS/config problem — the database just hadn't finished starting
# yet). pg_isready polls until it's actually ready instead of assuming
# Render's dependency ordering covers this.
echo "Waiting for database to accept connections..."
for i in $(seq 1 30); do
  if pg_isready -d "$DATABASE_URL" -q; then
    echo "Database is ready."
    break
  fi
  if [ "$i" -eq 30 ]; then
    echo "Database never became ready after 30 attempts (~2.5 minutes) — giving up." >&2
    exit 1
  fi
  sleep 5
done

bin/rails db:prepare
bin/rails db:seed

# Both children are started in the background so this script's own PID 1
# can trap and forward SIGTERM/SIGINT to both on container stop/redeploy —
# `bin/rails server & exec ...` would leave Sidekiq unable to receive the
# signal at all (Docker only signals PID 1).
bundle exec sidekiq &
sidekiq_pid=$!

bin/rails server -b 0.0.0.0 &
puma_pid=$!

trap 'kill -TERM "$sidekiq_pid" "$puma_pid" 2>/dev/null' TERM INT

# Exit as soon as either process dies, with its exit code — mirrors how a
# single-process container normally behaves, and surfaces a Sidekiq crash
# as a container failure instead of silently limping along web-only.
wait -n "$sidekiq_pid" "$puma_pid"
exit_code=$?
kill -TERM "$sidekiq_pid" "$puma_pid" 2>/dev/null
wait
exit "$exit_code"
